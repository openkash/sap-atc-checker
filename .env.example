# SAP Connection Configuration
# Copy this file to .env and fill in your values.

# Required
SAP_HOST=your-sap-host.com
SAP_CLIENT=100
SAP_USERNAME=YOUR_USERNAME
SAP_PASSWORD=YOUR_PASSWORD

# Optional
SAP_INSTANCE_NUMBER=00
SAP_LANGUAGE=EN
SAP_SECURE=true
SAP_SID=DEV

# TLS Certificate Validation (default: true)
# Set to 'false' only for development systems with self-signed certificates
SAP_REJECT_UNAUTHORIZED=true

# Logging
LOG_TO_FILE=false
LOGS_DIR=logs

# Reports
REPORTS_DIR=reports
